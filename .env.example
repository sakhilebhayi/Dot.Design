# Dot.Design environment. Copy to .env. docs/deployment.md has the production checklist; `php artisan design:preflight`
# reads the result back and says what is wrong. Lines starting with `#` show a setting at its default.
#
# This file is written for LOCAL development. The live host's .env must differ in the values marked LIVE; the deploy
# workflow forces APP_DEBUG=false and APP_ENV=production on every run whatever the file says.

# ---------------------------------------------------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------------------------------------------------
APP_NAME="Dot.Design"
# LIVE: production (forced by the deploy).
APP_ENV=local
# Generate once (php artisan key:generate, or php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;') and NEVER change it
# on a live site: it signs everyone out and breaks anything encrypted. Keep a copy outside the host.
APP_KEY=
# LIVE: false (forced by the deploy).
APP_DEBUG=true
# LIVE: https://design.infodot.co.za . Used for links in emails and share links.
APP_URL=http://design.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------------------------------
LOG_CHANNEL=stack
# LIVE: warning (debug floods the log).
LOG_LEVEL=debug

# ---------------------------------------------------------------------------------------------------------------------
# Database. LIVE: PostgreSQL (the cPanel database and role). Tests use SQLite in memory (phpunit.xml).
# ---------------------------------------------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# Sessions, cache, queue
# ---------------------------------------------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# LIVE (https): true, so the session cookie never travels over http.
# SESSION_SECURE_COOKIE=true

CACHE_STORE=database
FILESYSTEM_DISK=local

# LIVE: database. The host runs `queue:work --stop-when-empty` from cron every minute (no daemon); use `sync` only locally.
# Queued work: Dot.Notify emails, the Dot.Analytics snapshot. All on the default queue.
QUEUE_CONNECTION=database

# No WebSocket server can run on the shared host and nothing in the app broadcasts. Keep `log`.
BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------------------------------------------------
# Mail (password resets and account mail). LIVE: smtp with the account the other Dot apps use; `log` silently writes
# every mail to the log file and nobody receives it. Review/approval/comment emails go through Dot.Notify, not here.
# ---------------------------------------------------------------------------------------------------------------------
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------------------------------------------------
# Sign-in through InfoDot (the redeem flow). INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_DESIGN in InfoDot's .env.
# Leave it blank to accept only tokens found in this app's own database (nobody can then sign in through InfoDot).
# Never commit a real secret.
# ---------------------------------------------------------------------------------------------------------------------
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=design
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true
# Targets of the platform-switcher links (config/ecosystem.php defaults to the dead *.infodot.app addresses). LIVE: at least
DOT_INFODOT_URL=https://infodot.co.za
# DOT_FILES_URL=https://files.infodot.co.za
# DOT_NOTIFY_URL=https://notify.infodot.co.za
# (the other DOT_*_URL variables follow the same pattern; see config/ecosystem.php)

# ---------------------------------------------------------------------------------------------------------------------
# Assistant (AI). OFF until ANTHROPIC_API_KEY is set; with no key every deterministic feature (brief recommender,
# automatic fixes, resize suggestions) still works and nothing is sent anywhere. WITH a key, every compose / improve /
# copy request is a billed model call: cost is bounded by the daily caps below (per person and per workspace, failed
# calls count). docs/R45_AI.md and docs/R45_OPERATIONS.md ("Switch the assistant on").
# ---------------------------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# DESIGN_AI_ENABLED=true
# DESIGN_AI_MODEL=claude-sonnet-5-5
# DESIGN_AI_USER_DAILY=60
# DESIGN_AI_WORKSPACE_DAILY=300
# DESIGN_AI_PER_MINUTE=12
# DESIGN_AI_TIMEOUT=60
# DESIGN_AI_RETRIES=2
# DESIGN_AI_BASE_URL=https://api.anthropic.com
# Legacy AI image placeholder (nothing in the product links to it). `mock` is the only safe value: no environment may
# silently make real, billed image calls.
AI_IMAGE_DRIVER=mock

# ---------------------------------------------------------------------------------------------------------------------
# Uploads (all optional; defaults shown). Private disk, never under public/. Limits in config/design.php.
# ---------------------------------------------------------------------------------------------------------------------
# DESIGN_ASSET_DISK=design_assets
# DESIGN_ASSET_QUOTA_MB=200
# DESIGN_ASSET_UPLOADS_PER_MINUTE=20
# GD re-encodes uploads (strips EXIF/GPS and appended data). Turning this off stores originals unmodified.
# DESIGN_ASSET_REENCODE=true
# Absolute path to a .ttf for the legacy SERVER PNG exporter only (the editor exports in the browser); unset = that
# endpoint refuses canvases with text.
# DESIGN_EXPORT_FONT=

# Throttles per person per minute (defaults shown).
# DESIGN_SAVES_PER_MINUTE=120
# DESIGN_SHARES_PER_MINUTE=20
# DESIGN_COMMENTS_PER_MINUTE=30
# DESIGN_THUMBNAILS_PER_MINUTE=30
# DESIGN_EXPORTS_PER_MINUTE=60
# Public share links, per link and visitor address.
# DESIGN_PUBLIC_VIEWS_PER_MINUTE=120
# DESIGN_PUBLIC_COMMENTS_PER_MINUTE=6

# ---------------------------------------------------------------------------------------------------------------------
# Browser security headers (config/security.php). HSTS is sent on HTTPS responses only, in seconds (0 turns it off); no
# includeSubDomains. The Content-Security-Policy is report-only: violations are logged through /csp-report. Setting
# SECURITY_CSP_REPORT_ONLY=false would enforce it; leave that until the reports have been reviewed.
# ---------------------------------------------------------------------------------------------------------------------
SECURITY_HSTS_SECONDS=15552000
SECURITY_CSP_REPORT_ONLY=true

# ---------------------------------------------------------------------------------------------------------------------
# Dot.Analytics daily snapshot (two aggregate counts, queued, never affects this app). Nothing is sent until ALL THREE of
# the url, the secret and the company uuid are set. URL is the full ingest URL ending /api/ingest/snapshots; the secret
# equals ANALYTICS_INGEST_SECRET_DESIGN in Dot.Analytics. Design content belongs to users, not companies, so the numbers
# describe the platform and are filed under the operator's own InfoDot company uuid.
# ---------------------------------------------------------------------------------------------------------------------
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=design
ANALYTICS_COMPANY_UUID=

# ---------------------------------------------------------------------------------------------------------------------
# Integrations with other Dot platforms (R-45, docs/R45_INTEGRATIONS.md). Every one is OFF until its flag AND its
# url/secret are set; the app behaves exactly the same without them. The OWNER steps on the other platform come first
# (docs/R45_OPERATIONS.md, "Switch an integration on"): switching a flag on before they are done only produces failures.
# ---------------------------------------------------------------------------------------------------------------------
# Dot.Notify: emails workspace members about shares, review requests/decisions and comments.
# Secret = NOTIFY_INGEST_SECRET_DESIGN in Dot.Notify. Needs the queue worker.
DESIGN_INTEGRATION_NOTIFY=false
NOTIFY_INGEST_URL=
NOTIFY_INGEST_SECRET=
# NOTIFY_PLATFORM_KEY=design
# NOTIFY_INGEST_TIMEOUT=5

# Dot.Files: save an exported design in the business's Dot.Files.
# Secret = DOT_SERVICE_SECRET_DESIGN in Dot.Files, which must list `design` in its platform_secrets.
DESIGN_INTEGRATION_FILES=false
FILES_API_URL=https://files.infodot.co.za
FILES_PLATFORM_SECRET=
# FILES_PLATFORM_KEY=design
# FILES_FOLDER=Dot.Design
# FILES_TIMEOUT=20

# InfoDot membership webhook: removed members lose access at once instead of at next sign-in.
# Uses INFODOT_SERVICE_SECRET above; add `design` to ECOSYSTEM_MEMBERSHIP_PLATFORMS in InfoDot.
DESIGN_INTEGRATION_MEMBERSHIP=false

# After this many failed calls in a row an integration pauses for the cooldown (seconds).
# DESIGN_INTEGRATION_BREAKER_THRESHOLD=5
# DESIGN_INTEGRATION_BREAKER_COOLDOWN=120
