APP_NAME="Dot.Design"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://design.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# AI_IMAGE_DRIVER=mock is the safe default -- no environment silently makes
# real, billed AI image-generation calls until this is deliberately set to
# a real provider key with a matching driver registered in config/ai_image.php.
AI_IMAGE_DRIVER=mock

# Signed InfoDot sign-in (the redeem flow). Set INFODOT_SERVICE_SECRET to the same value as
# ECOSYSTEM_SECRET_DESIGN in InfoDot's .env; leave it blank to accept only tokens found in this
# app's own database. Never commit a real secret.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=design
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Dot.Design uploads (all optional; defaults shown). See README "Uploads".
# DESIGN_ASSET_DISK=design_assets
# DESIGN_ASSET_QUOTA_MB=200
# DESIGN_ASSET_UPLOADS_PER_MINUTE=20
# DESIGN_ASSET_REENCODE=true
# Absolute path to a .ttf for PNG export text; unset = PNG export refuses text.
# DESIGN_EXPORT_FONT=

# Dot.Analytics daily snapshot (aggregate counts only, queued, never affects this app).
# Nothing is sent until ALL THREE of the url, the secret and the company uuid are set.
# URL is the full ingest URL ending /api/ingest/snapshots; the secret equals ANALYTICS_INGEST_SECRET_DESIGN
# in Dot.Analytics. Design content belongs to users, not companies, so the numbers describe the platform and
# are filed under the operator's own InfoDot company uuid.
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=design
ANALYTICS_COMPANY_UUID=

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false

# Browser security headers (config/security.php). HSTS is sent on HTTPS responses only, in seconds (0 turns it off); no
# includeSubDomains. The Content-Security-Policy is report-only: violations are logged through /csp-report. Setting
# SECURITY_CSP_REPORT_ONLY=false would enforce it; leave that until the reports have been reviewed.
SECURITY_HSTS_SECONDS=15552000
SECURITY_CSP_REPORT_ONLY=true
