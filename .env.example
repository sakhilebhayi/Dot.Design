APP_NAME="Dot.Design"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://design.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
# info keeps the security.* lines (sign-in, lockout, credential changes) that incident response reads.
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Dot.Design assistant (config/design_ai.php, docs/R45_AI.md). Off unless ANTHROPIC_API_KEY is set. Defaults shown.
# DESIGN_AI_ENABLED=true
# DESIGN_AI_MODEL=claude-sonnet-5-5
# DESIGN_AI_USER_DAILY=60
# DESIGN_AI_WORKSPACE_DAILY=300

# AI_IMAGE_DRIVER=mock is the safe default -- no environment silently makes
# real, billed AI image-generation calls until this is deliberately set to
# a real provider key with a matching driver registered in config/ai_image.php.
AI_IMAGE_DRIVER=mock

# Signed InfoDot sign-in (the redeem flow). Set INFODOT_SERVICE_SECRET to the same value as
# ECOSYSTEM_SECRET_DESIGN in InfoDot's .env; leave it blank to accept only tokens found in this
# app's own database. Never commit a real secret.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=design
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Dot.Design uploads (all optional; defaults shown). See README "Uploads".
# DESIGN_ASSET_DISK=design_assets
# DESIGN_ASSET_QUOTA_MB=200
# DESIGN_ASSET_UPLOADS_PER_MINUTE=20
# DESIGN_ASSET_REENCODE=true
# Absolute path to a .ttf for PNG export text; unset = PNG export refuses text.
# DESIGN_EXPORT_FONT=

# Dot.Analytics daily snapshot (aggregate counts only, queued, never affects this app).
# Nothing is sent until ALL THREE of the url, the secret and the company uuid are set.
# URL is the full ingest URL ending /api/ingest/snapshots; the secret equals ANALYTICS_INGEST_SECRET_DESIGN
# in Dot.Analytics. Design content belongs to users, not companies, so the numbers describe the platform and
# are filed under the operator's own InfoDot company uuid.
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=design
ANALYTICS_COMPANY_UUID=

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false

# Browser security headers (config/security.php). HSTS is sent on HTTPS responses only, in seconds (0 turns it off); no
# includeSubDomains. The Content-Security-Policy is enforced (nonce based, see app/Http/Middleware/SecurityHeaders.php); set
# SECURITY_CSP_REPORT_ONLY=true only to fall back to report-only while a violation is investigated (reports go to /csp-report).
SECURITY_HSTS_SECONDS=15552000
SECURITY_CSP_REPORT_ONLY=false

# Integrations with other Dot platforms (R-45, docs/R45_INTEGRATIONS.md). Every one is OFF until its flag AND its url/secret are set.
# Dot.Notify: emails workspace members about shares, review requests/decisions and comments. Secret = NOTIFY_INGEST_SECRET_DESIGN in Dot.Notify.
DESIGN_INTEGRATION_NOTIFY=false
NOTIFY_INGEST_URL=
NOTIFY_INGEST_SECRET=
# Dot.Files: save an exported design in the business's Dot.Files. Secret = DOT_SERVICE_SECRET_DESIGN in Dot.Files (which must list `design`).
DESIGN_INTEGRATION_FILES=false
FILES_API_URL=https://files.infodot.co.za
FILES_PLATFORM_SECRET=
# InfoDot membership webhook: removed members lose access at once (uses INFODOT_SERVICE_SECRET; add `design` to InfoDot's ECOSYSTEM_MEMBERSHIP_PLATFORMS).
DESIGN_INTEGRATION_MEMBERSHIP=false
